---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';

const pageTitle = 'Kontakt | Heizungsbauer & Sanitär Köln/Hürth | ESH Haustechnik';
const pageDescription = 'Kontaktieren Sie ESH Haustechnik – Ihr Heizungsbauer, Klempner und Badsanierer für Heizungsreparatur, Badrenovierung und Heizungsnotdienst in Hürth, Köln und Umgebung. Rufen Sie an, schreiben Sie per WhatsApp oder nutzen Sie unser Kontaktformular.';

// TODO: Web3Forms Access Key eintragen
const WEB3FORMS_ACCESS_KEY = 'YOUR_ACCESS_KEY_HERE';
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main>
    <!-- Page Header -->
    <section class="bg-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">Kontaktieren Sie Ihren Heizungsbauer & Klempner</h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">
          Wir freuen uns auf Ihre Nachricht. Rufen Sie uns an, schreiben Sie uns oder füllen Sie das Formular aus – wir melden uns schnellstmöglich bei Ihnen.
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <!-- Contact Info -->
          <div>
            <h2 class="text-3xl font-bold text-primary mb-6">Direkter Kontakt</h2>
            <p class="text-gray-600 leading-relaxed mb-8">
              Egal ob Heizungsausfall, Heizungsreparatur, Badsanierung, Badrenovierung oder eine allgemeine Anfrage – wir sind als Ihr Heizungsbauer und Klempner in Hürth, Köln und der Region für Sie da. Nutzen Sie eine der folgenden Kontaktmöglichkeiten oder füllen Sie das Formular aus.
            </p>

            <div class="space-y-6">
              <a href="tel:015565258799" class="flex items-start gap-4 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg p-2 -ml-2" aria-label="Telefonisch kontaktieren">
                <div class="w-12 h-12 bg-accent/10 text-accent rounded-lg flex items-center justify-center group-hover:bg-accent group-hover:text-white transition-all duration-300" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-primary">Telefon</p>
                  <p class="text-accent text-lg font-medium group-hover:text-primary transition-colors duration-300">01556 5258799</p>
                </div>
              </a>

              <a href="mailto:Info@eshhaustechnik.de" class="flex items-start gap-4 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg p-2 -ml-2" aria-label="Per E-Mail kontaktieren">
                <div class="w-12 h-12 bg-accent/10 text-accent rounded-lg flex items-center justify-center group-hover:bg-accent group-hover:text-white transition-all duration-300" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-primary">E-Mail</p>
                  <p class="text-accent text-lg font-medium group-hover:text-primary transition-colors duration-300">Info@eshhaustechnik.de</p>
                </div>
              </a>

              <a href="https://wa.me/4915565258799" target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg p-2 -ml-2" aria-label="WhatsApp Nachricht senden">
                <div class="w-12 h-12 bg-accent/10 text-accent rounded-lg flex items-center justify-center group-hover:bg-accent group-hover:text-white transition-all duration-300" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-primary">WhatsApp</p>
                  <p class="text-accent text-lg font-medium group-hover:text-primary transition-colors duration-300">01556 5258799</p>
                </div>
              </a>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-accent/10 text-accent rounded-lg flex items-center justify-center" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-primary">Adresse</p>
                  <p class="text-gray-600">Elbingstr 2<br />50354 Hürth</p>
                </div>
              </div>
            </div>

            <!-- Map Placeholder -->
            <div class="mt-10">
              <div class="aspect-video bg-gray-100 rounded-xl border border-gray-200 overflow-hidden">
                <!-- TODO: Karte nur nach Cookie-Consent laden (Two-Click-Solution) -->
                <div id="map-placeholder" class="w-full h-full flex flex-col items-center justify-center text-gray-500 p-6 text-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mb-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-.806-.984A10.001 10.001 0 018.022 6.093L9 7m0 13V7" />
                  </svg>
                  <p class="font-medium text-primary mb-1">Karte laden</p>
                  <p class="text-sm text-gray-500 mb-3">Durch das Laden stimmen Sie der Datenübermittlung an Google Maps zu.</p>
                  <button
                    type="button"
                    id="load-map-btn"
                    class="px-4 py-2 bg-accent text-white text-sm font-medium rounded-md hover:bg-primary transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent"
                    aria-label="Google Maps Karte laden"
                  >
                    Karte anzeigen
                  </button>
                </div>
                <div id="map-container" class="hidden w-full h-full"></div>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="bg-gray-50 rounded-2xl p-6 sm:p-8 lg:p-10 border border-gray-100">
            <h2 class="text-2xl font-bold text-primary mb-2">Schreiben Sie uns</h2>
            <p class="text-gray-600 text-sm mb-6">Füllen Sie das Formular aus. Wir melden uns innerhalb von 24 Stunden bei Ihnen.</p>

            <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
              <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
              <input type="hidden" name="subject" value="Neue Kontaktanfrage über ESH Haustechnik Website" />
              <input type="hidden" name="from_name" value="ESH Haustechnik Website" />
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

              <!-- Honeypot -->
              <div class="hidden" aria-hidden="true">
                <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium text-primary mb-1.5">Name <span class="text-accent">*</span></label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 bg-white text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-all duration-300"
                    placeholder="Max Mustermann"
                  />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-primary mb-1.5">Telefon</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="w-full px-4 py-3 rounded-lg border border-gray-300 bg-white text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-all duration-300"
                    placeholder="0151 23456789"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-primary mb-1.5">E-Mail <span class="text-accent">*</span></label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 bg-white text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-all duration-300"
                  placeholder="max@beispiel.de"
                />
              </div>

              <div>
                <label for="service" class="block text-sm font-medium text-primary mb-1.5">Leistung</label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-all duration-300"
                >
                  <option value="">Bitte wählen</option>
                  <option value="heizung">Heizungsinstallation / -wartung</option>
                  <option value="bad">Badsanierung / Badmodernisierung</option>
                  <option value="notdienst">Rohrbruch / Notdienst</option>
                  <option value="sonstiges">Sonstiges</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-primary mb-1.5">Nachricht <span class="text-accent">*</span></label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-gray-300 bg-white text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition-all duration-300 resize-y"
                  placeholder="Beschreiben Sie kurz Ihr Anliegen..."
                ></textarea>
              </div>

              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="privacy"
                  name="privacy"
                  required
                  class="mt-1 w-4 h-4 text-accent border-gray-300 rounded focus:ring-accent"
                />
                <label for="privacy" class="text-sm text-gray-600">
                  Ich habe die <a href="/datenschutz" class="text-accent hover:underline underline-offset-2">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu. <span class="text-accent">*</span>
                </label>
              </div>

              <Button type="submit" variant="primary" size="md" class="w-full" ariaLabel="Nachricht absenden">
                Nachricht absenden
              </Button>
            </form>

            <!-- Success Message -->
            <div id="form-success" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-800" role="status" aria-live="polite">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <p class="font-semibold">Vielen Dank für Ihre Nachricht!</p>
                  <p class="text-sm">Wir haben Ihre Anfrage erhalten und melden uns innerhalb von 24 Stunden bei Ihnen.</p>
                </div>
              </div>
            </div>

            <!-- Error Message -->
            <div id="form-error" class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-800" role="alert" aria-live="assertive">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <p class="font-semibold">Es ist ein Fehler aufgetreten.</p>
                  <p class="text-sm">Bitte versuchen Sie es später erneut oder rufen Sie uns direkt an.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Contact Form AJAX Handler
    (function () {
      const form = document.getElementById('contact-form');
      const successMsg = document.getElementById('form-success');
      const errorMsg = document.getElementById('form-error');

      if (!form) return;

      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (successMsg) successMsg.classList.add('hidden');
        if (errorMsg) errorMsg.classList.add('hidden');

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Honeypot check
        if (data._gotcha) {
          return;
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify(data),
          });

          const result = await response.json();

          if (response.ok && result.success) {
            form.reset();
            if (successMsg) successMsg.classList.remove('hidden');
            successMsg?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            throw new Error(result.message || 'Submission failed');
          }
        } catch (err) {
          if (errorMsg) errorMsg.classList.remove('hidden');
          errorMsg?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    })();

    // Two-Click Map Loader
    (function () {
      const loadBtn = document.getElementById('load-map-btn');
      const placeholder = document.getElementById('map-placeholder');
      const container = document.getElementById('map-container');

      if (!loadBtn || !placeholder || !container) return;

      loadBtn.addEventListener('click', function () {
        placeholder.classList.add('hidden');
        container.classList.remove('hidden');

        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2511.0!2d6.9!3d50.88!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47bf2f7c3c3c3c3c%3A0x3c3c3c3c3c3c3c3c!2sElbingstra%C3%9Fe%202%2C%2050354%20H%C3%BCrth!5e0!3m2!1sde!2sde!4v1600000000000!5m2!1sde!2sde';
        iframe.width = '100%';
        iframe.height = '100%';
        iframe.style.border = '0';
        iframe.allowFullscreen = true;
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.title = 'Standort ESH Haustechnik auf Google Maps';

        container.appendChild(iframe);
      });
    })();
  </script>
</Layout>
