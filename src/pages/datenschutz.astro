---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const datenschutzModules = import.meta.glob('../content/pages/datenschutz.md', { eager: true });
const datenschutz = Object.values(datenschutzModules)[0] as any;
---

<Layout title={datenschutz.frontmatter.meta.title} description={datenschutz.frontmatter.meta.description}>
  <Header />

  <main id="main-content" class="flex-grow">
    <section class="bg-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">Datenschutzerklärung</h1>
      </div>
    </section>

    <section class="py-16 lg:py-24 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg text-gray-600">
          <datenschutz.default />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
