---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';

const pageTitle = 'Heizungsbauer & Sanitär in Köln & Hürth | ESH Haustechnik | Badsanierung & Notdienst';
const pageDescription = 'Ihr Heizungsbauer, Klempner und Sanitär-Experte für Heizungsreparatur, Badsanierung, Badrenovierung und 24h Heizungsnotdienst in Hürth, Köln und Umgebung. ESH Haustechnik – Erol Saybak. Kompetent, zuverlässig, fair. Jetzt anrufen!';

const services = [
  {
    title: 'Heizungsinstallation',
    description: 'Von der modernen Gasheizung bis zur energieeffizienten Wärmepumpe – wir planen und installieren Ihre neue Heizungsanlage fachgerecht und termintreu.',
    image: '/leistung1.jpg',
    href: '/leistungen#heizung',
  },
  {
    title: 'Heizungswartung',
    description: 'Regelmäßige Wartung verlängert die Lebensdauer Ihrer Anlage, senkt die Heizkosten und sorgt für zuverlässige Wärme an kalten Tagen.',
    image: '/leistung2.jpg',
    href: '/leistungen#wartung',
  },
  {
    title: 'Badsanierung',
    description: 'Wir verwandeln Ihr altes Bad in eine moderne Wohlfühloase – von der Planung über die Installation bis zum fertigen Ergebnis aus einer Hand.',
    image: '/leistung3.jpg',
    href: '/leistungen#bad',
  },
  {
    title: 'Rohrbruch & Notdienst',
    description: 'Wasserrohrbruch oder Heizungsausfall? Unser schneller Kundendienst ist für Sie da – kompetente Störungsbeseitigung rund um Hürth und Köln.',
    image: '/leistung4.jpg',
    href: '/leistungen#notdienst',
  },
];

const cities = ['Hürth', 'Köln', 'Frechen', 'Kerpen', 'Brühl', 'Erftstadt', 'Bergheim'];
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative bg-primary overflow-hidden">
      <div class="absolute inset-0">
        <img 
          src="/hero.jpg" 
          alt="ESH Haustechnik – Heizung und Sanitär in Hürth" 
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-primary/80"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 bg-accent/20 text-white px-4 py-1.5 rounded-full text-sm font-medium mb-6">
            <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
            Ihr Fachbetrieb für Heizung & Sanitär
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
            Heizungsbauer & Sanitär in Hürth und Köln
          </h1>
          <p class="text-lg sm:text-xl text-gray-300 mb-8 leading-relaxed max-w-2xl">
            Willkommen bei <strong class="text-white">ESH Haustechnik</strong>. Wir sind Ihr zuverlässiger Heizungsbauer, Klempner und Partner für moderne Heizungsanlagen, Heizungsreparatur, professionelle Badsanierung, Badrenovierung und schnelle Hilfe bei Rohrbrüchen – persönlich, fair und aus einer Hand.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <Button href="tel:015565258799" variant="primary" size="lg" ariaLabel="Jetzt anrufen: 015565258799">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Jetzt anrufen
            </Button>
            <Button href="/kontakt" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary" ariaLabel="Kontaktformular öffnen">
              Kontakt aufnehmen
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Bar -->
    <section class="bg-gray-50 border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="font-semibold text-primary">Fachgerechte Ausführung</p>
            <p class="text-sm text-gray-500">Qualität aus Meisterhand</p>
          </div>
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="font-semibold text-primary">Termintreue</p>
            <p class="text-sm text-gray-500">Pünktlich & zuverlässig</p>
          </div>
          <div class="flex flex-col items-center">
            <div class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <p class="font-semibold text-primary">Lokaler Ansprechpartner</p>
            <p class="text-sm text-gray-500">Aus Hürth für die Region</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Emergency Banner -->
    <section class="bg-accent" aria-label="Notdienst-Hinweis">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div>
              <p class="font-bold text-lg">Heizungsausfall oder Rohrbruch?</p>
              <p class="text-white/90 text-sm">Schnelle Hilfe im Notfall – wir sind für Sie da.</p>
            </div>
          </div>
          <a
            href="tel:015565258799"
            class="inline-flex items-center justify-center bg-white text-accent px-6 py-3 rounded-md font-bold hover:bg-gray-100 transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white"
            aria-label="Notdienst anrufen: 015565258799"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            01556 5258799
          </a>
        </div>
      </div>
    </section>

    <!-- Services Overview -->
    <section class="py-16 lg:py-24 bg-white" id="leistungen">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          title="Unsere Leistungen für Ihr Zuhause"
          subtitle="Von der ersten Beratung bis zur fertigen Installation – wir begleiten Sie bei allen Fragen rund um Heizung, Sanitär und moderne Bäder."
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {services.map((service) => (
            <Card
              title={service.title}
              description={service.description}
              image={service.image}
              imageAlt={service.title}
              href={service.href}
            />
          ))}
        </div>
        <div class="mt-12 text-center">
          <Button href="/leistungen" variant="primary" size="md" ariaLabel="Alle Leistungen ansehen">
            Alle Leistungen ansehen
          </Button>
        </div>
      </div>
    </section>

    <!-- Why Us -->
    <section class="py-16 lg:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-6">
              Warum ESH Haustechnik?
            </h2>
            <div class="space-y-5 text-gray-600 leading-relaxed">
              <p>
                Als inhabergeführter Handwerksbetrieb und Heizungsbauer aus Hürth legen wir Wert auf persönliche Beratung, saubere Arbeit und ehrliche Preise. Bei uns gibt es keine Überraschungen – nur handwerkliche Qualität, auf die Sie sich verlassen können.
              </p>
              <p>
                Egal, ob Sie eine neue Heizungsanlage planen, eine Heizungsreparatur benötigen, Ihr Bad modernisieren möchten oder schnelle Hilfe bei einem Rohrbruch brauchen: Wir kümmern uns um Ihr Anliegen mit Engagement und Fachwissen.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Persönliche Beratung vor Ort</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Transparente Kosten ohne versteckte Aufschläge</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Moderne, energieeffiziente Lösungen</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Schneller Kundendienst in der Region Köln</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="relative">
            <div class="aspect-[4/3] bg-gray-200 rounded-2xl overflow-hidden">
              <img 
                src="/warumwir.jpg" 
                alt="Erol Saybak bei der Arbeit – ESH Haustechnik" 
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Local SEO Section -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          title="Ihr Heizungs- und Sanitärinstallateur in der Region"
          subtitle="Wir sind für Sie in Hürth und allen umliegenden Städten im Raum Köln unterwegs."
        />
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {cities.map((city) => (
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-4 py-4 text-center hover:border-accent/30 hover:bg-accent/5 transition-all duration-300">
              <p class="font-semibold text-primary">Heizung & Sanitär</p>
              <p class="text-accent font-medium">{city}</p>
            </div>
          ))}
        </div>
        <div class="mt-12 max-w-3xl mx-auto text-center text-gray-600 leading-relaxed">
          <p>
            Sie suchen einen erfahrenen Heizungsbauer oder einen kompetenten Partner für Ihre Badsanierung in <strong>Hürth, Köln oder der Umgebung</strong>? Dann sind Sie bei ESH Haustechnik genau richtig. Wir kennen die Region, die örtlichen Gegebenheiten und die Anforderungen der Häuser hier – und bringen dieses Know-how in jedes Projekt ein.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 lg:py-24 bg-primary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          Bereit für Ihr nächstes Projekt?
        </h2>
        <p class="text-lg text-gray-300 mb-8">
          Rufen Sie uns an oder schreiben Sie uns eine Nachricht. Wir beraten Sie gerne unverbindlich.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="tel:015565258799" variant="primary" size="lg" class="bg-accent hover:bg-white hover:text-primary" ariaLabel="Jetzt anrufen">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            01556 5258799
          </Button>
          <Button href="/kontakt" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary" ariaLabel="Kontakt aufnehmen">
            Nachricht schreiben
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
