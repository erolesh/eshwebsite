---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import globalData from '../content/settings/global.json';
import homeData from '../content/pages/home.json';

const pageTitle = homeData.meta.title;
const pageDescription = homeData.meta.description;
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main-content">
    <!-- Hero -->
    <section class="relative bg-primary overflow-hidden">
      <div class="absolute inset-0">
        <img 
          src={homeData.hero.image} 
          alt={homeData.hero.imageAlt} 
          width="1376"
          height="768"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-primary/80"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 bg-accent/20 text-white px-4 py-1.5 rounded-full text-sm font-medium mb-6">
            <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
            {homeData.hero.badge}
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
            {homeData.hero.title}
          </h1>
          <p class="text-lg sm:text-xl text-gray-300 mb-8 leading-relaxed max-w-2xl">
            {homeData.hero.text}
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <Button href={'tel:' + globalData.contact.phoneLink} variant="primary" size="lg" ariaLabel={homeData.hero.primaryButton + ': ' + globalData.contact.phoneDisplay}>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              {homeData.hero.primaryButton}
            </Button>
            <Button href="/kontakt" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary" ariaLabel={homeData.hero.secondaryButton}>
              {homeData.hero.secondaryButton}
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Bar -->
    <section class="bg-gray-50 border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
          {homeData.trustBar.map((item) => (
            <div class="flex flex-col items-center">
              <div class="w-10 h-10 bg-accent/10 text-accent rounded-full flex items-center justify-center mb-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <p class="font-semibold text-primary">{item.title}</p>
              <p class="text-sm text-gray-500">{item.subtitle}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Emergency Banner -->
    <section class="bg-accent" aria-label="Notdienst-Hinweis">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div>
              <p class="font-bold text-lg">{homeData.emergency.title}</p>
              <p class="text-white/90 text-sm">{homeData.emergency.subtitle}</p>
            </div>
          </div>
          <a
            href={'tel:' + globalData.contact.phoneLink}
            class="inline-flex items-center justify-center bg-white text-accent px-6 py-3 rounded-md font-bold hover:bg-gray-100 transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white"
            aria-label={homeData.emergency.buttonText + ': ' + globalData.contact.phoneDisplay}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {homeData.emergency.buttonText}
          </a>
        </div>
      </div>
    </section>

    <!-- Services Overview -->
    <section class="py-16 lg:py-24 bg-white" id="leistungen">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          title={homeData.services.header.title}
          subtitle={homeData.services.header.subtitle}
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {homeData.services.items.map((service) => (
            <Card
              title={service.title}
              description={service.description}
              image={service.image}
              imageAlt={service.title}
              href={service.href}
            />
          ))}
        </div>
        <div class="mt-12 text-center">
          <Button href="/leistungen" variant="primary" size="md" ariaLabel={homeData.services.buttonText}>
            {homeData.services.buttonText}
          </Button>
        </div>
      </div>
    </section>

    <!-- Why Us -->
    <section class="py-16 lg:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-6">
              {homeData.whyUs.title}
            </h2>
            <div class="space-y-5 text-gray-600 leading-relaxed">
              <p>{homeData.whyUs.paragraph1}</p>
              <p>{homeData.whyUs.paragraph2}</p>
              <ul class="space-y-3">
                {homeData.whyUs.usps.map((usp) => (
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{usp}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="relative">
            <div class="aspect-[4/3] bg-gray-200 rounded-2xl overflow-hidden">
              <img 
                src={homeData.whyUs.image} 
                alt={homeData.whyUs.imageAlt} 
                width="1024"
                height="1024"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Local SEO Section -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          title={homeData.localSeo.header.title}
          subtitle={homeData.localSeo.header.subtitle}
        />
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {globalData.cities.map((city) => (
            <div class="bg-gray-50 border border-gray-100 rounded-lg px-4 py-4 text-center hover:border-accent/30 hover:bg-accent/5 transition-all duration-300">
              <p class="font-semibold text-primary">Heizung & Sanitär</p>
              <p class="text-accent font-medium">{city}</p>
            </div>
          ))}
        </div>
        <div class="mt-12 max-w-3xl mx-auto text-center text-gray-600 leading-relaxed">
          <p>{homeData.localSeo.text}</p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 lg:py-24 bg-primary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          {homeData.cta.title}
        </h2>
        <p class="text-lg text-gray-300 mb-8">
          {homeData.cta.text}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href={'tel:' + globalData.contact.phoneLink} variant="primary" size="lg" class="bg-accent hover:bg-white hover:text-primary" ariaLabel={homeData.cta.primaryButton}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {homeData.cta.primaryButton}
          </Button>
          <Button href="/kontakt" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary" ariaLabel={homeData.cta.secondaryButton}>
            {homeData.cta.secondaryButton}
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
