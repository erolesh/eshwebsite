---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import globalData from '../content/settings/global.json';
import leistungenData from '../content/pages/leistungen.json';

const pageTitle = leistungenData.meta.title;
const pageDescription = leistungenData.meta.description;
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main-content">
    <!-- Page Header -->
    <section class="bg-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">{leistungenData.header.title}</h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">
          {leistungenData.header.text}
        </p>
      </div>
    </section>

    <!-- Sections -->
    {leistungenData.sections.map((section, index) => {
      const isEven = index % 2 === 0;
      const bgClass = isEven ? 'bg-white' : 'bg-gray-50';
      return (
        <section class={`py-16 lg:py-24 ${bgClass}`} id={section.id}>
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
              <div class={isEven ? 'order-2 lg:order-1' : ''}>
                <div class="aspect-[4/3] bg-gray-100 rounded-2xl overflow-hidden">
                  <img 
                    src={section.image} 
                    alt={section.imageAlt}
                    width="1200"
                    height="896"
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              </div>
              <div class={isEven ? 'order-1 lg:order-2' : ''}>
                <div class="inline-flex items-center gap-2 text-accent font-semibold text-sm mb-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                  </svg>
                  {section.badge}
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold text-primary mb-5">{section.title}</h2>
                <div class="space-y-4 text-gray-600 leading-relaxed">
                  <p>{section.paragraph1}</p>
                  {section.paragraph2 && <p>{section.paragraph2}</p>}
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                    {section.features.map((feature) => (
                      <li class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                  {section.noticeTitle && section.noticeItems && section.noticeItems.length > 0 && (
                    <div class="bg-white border-l-4 border-accent p-5 rounded-r-lg shadow-sm">
                      <p class="font-semibold text-primary mb-1">{section.noticeTitle}</p>
                      <ul class="space-y-1 text-gray-600">
                        {section.noticeItems.map((item) => (
                          <li>• {item}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </section>
      );
    })}

    <!-- CTA -->
    <section class="py-16 lg:py-24 bg-primary">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          {leistungenData.cta.title}
        </h2>
        <p class="text-lg text-gray-300 mb-8">
          {leistungenData.cta.text}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href={'tel:' + globalData.contact.phoneLink} variant="primary" size="lg" class="bg-accent hover:bg-white hover:text-primary" ariaLabel="Jetzt anrufen">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {globalData.contact.phoneDisplay}
          </Button>
          <Button href="/kontakt" variant="outline" size="lg" class="border-white text-white hover:bg-white hover:text-primary" ariaLabel="Kontakt aufnehmen">
            Anfrage senden
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
