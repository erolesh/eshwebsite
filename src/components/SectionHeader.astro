---
export interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, centered = true, light = false } = Astro.props;
---

<div class={`max-w-3xl ${centered ? 'mx-auto text-center' : ''} mb-10 lg:mb-14`}>
  <h2 class={`text-3xl sm:text-4xl font-bold mb-4 ${light ? 'text-white' : 'text-primary'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`text-lg leading-relaxed ${light ? 'text-gray-200' : 'text-gray-600'}`}>
      {subtitle}
    </p>
  )}
</div>
